---
import GlobalLayout from "../../layouts/global-layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { sortPosts, type PostFrontmatter } from "../../utils/posts";

const blogs = sortPosts(await Astro.glob<PostFrontmatter>("./**/*.md"));
---
<GlobalLayout title="Blog">
  <main>
    <SectionLabel as="h1" title="Blog" note="技術的な記事やプロジェクトの解説など" />
    <div class="blog-grid">
      {blogs.map((post) => (
        <BlogCard
          title={post.frontmatter.title}
          date={post.frontmatter.date}
          emoji={post.frontmatter.emoji}
          url={post.url}
          eyecatch={post.frontmatter.eyecatch}
          tags={post.frontmatter.tags}
        />
      ))}
    </div>
  </main>
</GlobalLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 24px;
  }

  @media (max-width: 960px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
