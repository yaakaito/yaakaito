---
import GlobalLayout from "../../layouts/global-layout.astro";
import PostList from "../../components/PostList.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { sortPosts, yearOf, type PostFrontmatter } from "../../utils/posts";
import icon from "../../../../icon/icon-128.png";

const notes = sortPosts(await Astro.glob<PostFrontmatter>("./**/*.md"));

// 新しい順のまま年ごとにまとめる
const notesByYear = new Map<string, typeof notes>();
for (const note of notes) {
  const year = yearOf(note.frontmatter.date);
  notesByYear.set(year, [...(notesByYear.get(year) ?? []), note]);
}

// OGP用の情報
const description = "短い備忘録や考え、アイデアなどのノートコレクション。技術的なメモや思考の断片を公開しています。";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

// 最新ノートのアイキャッチ画像があればそれを使用（なければデフォルトアイコン）
const ogImage = notes.length > 0 && notes[0].frontmatter.eyecatch
  ? `https://articles.yaakai.to/eyecatch?id=${notes[0].frontmatter.eyecatch}`
  : icon.src;
---
<GlobalLayout
  title="Note"
  description={description}
  ogImage={ogImage}
  ogType="website"
  ogUrl={canonicalUrl}
  twitterCard="summary_large_image"
  twitterCreator="@yaakaito"
>
  <main>
    <SectionLabel as="h1" title="Note" note="短い備忘録や考え、アイデアなど" />
    {[...notesByYear].map(([year, posts]) => (
      <section class="year-group">
        <h2 class="year">{year} <span>· {posts.length}</span></h2>
        <PostList
          dateFormat="month-day"
          items={posts.map((post) => ({
            title: post.frontmatter.title,
            date: post.frontmatter.date,
            emoji: post.frontmatter.emoji,
            url: post.url,
          }))}
        />
      </section>
    ))}
  </main>
</GlobalLayout>

<style>
  .year-group + .year-group {
    margin-top: 28px;
  }

  .year {
    display: flex;
    gap: 10px;
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: normal;
    letter-spacing: normal;
    color: var(--primary-color-level-0);
  }

  .year span {
    color: var(--text-color-level-2);
  }
</style>
