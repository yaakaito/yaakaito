---
import GlobalLayout from "../layouts/global-layout.astro";
import BlogCard from "../components/BlogCard.astro";
import PostList from "../components/PostList.astro";
import SectionLabel from "../components/SectionLabel.astro";
import * as humans from "../../humans.md";
import { excerptOf, sortPosts, type PostFrontmatter } from "../utils/posts";

const blogs = sortPosts(await Astro.glob<PostFrontmatter>("./blog/**/*.md"));
const notes = sortPosts(await Astro.glob<PostFrontmatter>("./note/**/*.md"));

// 最新の Blog を大きく 1 本、続く 3 本をカードで。Note は 1 行リストにして重複させない
const [featured, ...restBlogs] = blogs;
const recentBlogs = restBlogs.slice(0, 3);
const recentNotes = notes.slice(0, 6);
---

<GlobalLayout>
  <main>
    <!-- 紹介文は README と同じく humans.md から読み込む -->
    <div class="intro"><humans.Content /></div>

    <SectionLabel title="Blog" note={`${blogs.length} posts`} moreLink="/blog" />
    {featured && (
      <BlogCard
        variant="feature"
        title={featured.frontmatter.title}
        date={featured.frontmatter.date}
        emoji={featured.frontmatter.emoji}
        url={featured.url}
        eyecatch={featured.frontmatter.eyecatch}
        tags={featured.frontmatter.tags}
        excerpt={excerptOf(featured.rawContent())}
      />
    )}
    <div class="blog-grid">
      {recentBlogs.map((post) => (
        <BlogCard
          title={post.frontmatter.title}
          date={post.frontmatter.date}
          emoji={post.frontmatter.emoji}
          url={post.url}
          eyecatch={post.frontmatter.eyecatch}
        />
      ))}
    </div>

    <SectionLabel title="Note" note="短い備忘録" moreLink="/note" />
    <PostList
      items={recentNotes.map((post) => ({
        title: post.frontmatter.title,
        date: post.frontmatter.date,
        emoji: post.frontmatter.emoji,
        url: post.url,
      }))}
    />
  </main>
</GlobalLayout>

<style>
  .intro {
    padding-top: 32px;
    color: var(--text-color-level-0);
  }

  .intro :global(p) {
    margin: 0;
    font-size: 16px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  @media (max-width: 720px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
