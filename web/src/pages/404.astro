---
import GlobalLayout from '../layouts/global-layout.astro';
---

<GlobalLayout title="404 Not Found" description="ページが見つかりませんでした">
    <main class="not-found">
        <h1>404</h1>
        <p>ページが見つかりませんでした</p>
        <a href="/">トップへ戻る</a>
    </main>
</GlobalLayout>

<style>
    .not-found {
        display: grid;
        justify-items: center;
        align-content: center;
        gap: 8px;
        min-height: 50vh;
        text-align: center;
    }

    .not-found h1 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: normal;
        font-size: 6rem;
        line-height: 1;
        color: var(--text-color-level-2);
    }

    .not-found p {
        margin: 0 0 16px;
        color: var(--text-color-level-1);
    }

    .not-found a,
    .not-found a:visited {
        color: var(--primary-color-level-0);
    }
</style>
