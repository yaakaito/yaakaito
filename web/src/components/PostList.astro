---
import { formatDate, formatMonthDay } from "../utils/posts";

interface Item {
  title: string;
  date: string;
  emoji: string;
  url: string;
}

interface Props {
  items: Item[];
  /** 年ごとにまとめた一覧では年を省いて MM/DD で出す */
  dateFormat?: "full" | "month-day";
}

const { items, dateFormat = "full" } = Astro.props;
const format = dateFormat === "month-day" ? formatMonthDay : formatDate;
---

<ul class="post-list">
  {items.map(({ title, date, emoji, url }) => (
    <li>
      <a href={url}>
        <span class="post-list-emoji" aria-hidden="true">{emoji}</span>
        <span class="post-list-title">{title}</span>
        <time datetime={new Date(date).toISOString()}>{format(date)}</time>
      </a>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--bg-color-level-3);
  }

  .post-list li {
    margin: 0;
    line-height: inherit;
    letter-spacing: normal;
  }

  .post-list a,
  .post-list a:visited {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 11px 4px;
    border-top: 1px solid var(--bg-color-level-3);
    color: var(--text-color-level-0);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .post-list a:hover {
    background-color: var(--bg-color-level-1);
    color: var(--primary-color-level-0);
  }

  .post-list-emoji {
    font-size: 17px;
    text-align: center;
  }

  .post-list-title {
    font-size: 15px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .post-list time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-color-level-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
