---
import { getGenericEyecatchColor } from "../utils/eyecatch";
import { formatDate } from "../utils/posts";

interface Props {
  title: string;
  date: string;
  emoji: string;
  url: string;
  eyecatch?: string;
  tags?: string[];
  /** feature は画像と本文を横に並べた大きな表示。excerpt はこのときだけ出す */
  variant?: "feature" | "card";
  excerpt?: string;
}

const { title, date, emoji, url, eyecatch, tags = [], variant = "card", excerpt } = Astro.props;
const genericEyecatchColor = getGenericEyecatchColor(url);
const TitleTag = variant === "feature" ? "h2" : "h3";
---

<a href={url} class={`blog-card blog-card-${variant}`}>
  <div class="blog-card-image">
    {eyecatch ? (
      <img src={`https://articles.yaakai.to/eyecatch?id=${eyecatch}`} alt="" loading="lazy" />
    ) : (
      <div
        class="blog-card-generic"
        style={`background-image: url('https://articles.yaakai.to/common/${genericEyecatchColor}.png')`}
      >
        <span>{emoji}</span>
      </div>
    )}
  </div>
  <div class="blog-card-body">
    <div class="blog-card-meta">
      <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
      {tags.map((tag) => <span class="blog-card-tag">#{tag}</span>)}
    </div>
    <TitleTag class="blog-card-title">{title}</TitleTag>
    {variant === "feature" && excerpt && <p class="blog-card-excerpt">{excerpt}</p>}
  </div>
</a>

<style>
  .blog-card,
  .blog-card:visited,
  .blog-card:hover {
    display: grid;
    gap: 10px;
    align-content: start;
    color: var(--text-color-level-0);
    text-decoration: none;
  }

  .blog-card-image img,
  .blog-card-generic {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: 8px;
    image-rendering: pixelated;
  }

  .blog-card-generic {
    display: grid;
    place-items: center;
    background-size: cover;
    background-position: center;
    font-size: 3em;
    line-height: 1;
  }

  .blog-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-color-level-2);
  }

  .blog-card-tag {
    color: var(--primary-color-level-0);
  }

  .blog-card-title {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .blog-card:hover .blog-card-title {
    color: var(--primary-color-level-0);
  }

  .blog-card-feature {
    grid-template-columns: 1.15fr 1fr;
    gap: 28px;
    align-items: center;
  }

  .blog-card-feature .blog-card-body {
    display: grid;
    gap: 10px;
  }

  .blog-card-feature .blog-card-title {
    font-size: 26px;
    line-height: 1.4;
  }

  .blog-card-feature .blog-card-generic {
    font-size: 5em;
  }

  .blog-card-excerpt {
    margin: 0;
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-color-level-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-card-image {
      transition: transform 0.2s ease;
    }

    .blog-card:hover .blog-card-image {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 720px) {
    .blog-card-feature {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .blog-card-feature .blog-card-title {
      font-size: 21px;
    }

    /* 一覧の通常カードはサムネイル左・タイトル右に並べてスクロール量を減らす */
    .blog-card-card {
      grid-template-columns: 120px 1fr;
      gap: 12px;
      align-items: center;
    }

    .blog-card-card .blog-card-generic {
      font-size: 1.8em;
    }

    .blog-card-card .blog-card-body {
      display: grid;
      gap: 4px;
    }

    .blog-card-card .blog-card-title {
      font-size: 15px;
    }
  }
</style>
