---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// ライト ← 自動 → ダークの順。両端が固定で、真ん中がOS追従
const themes = [
  { value: 'light', icon: 'fa-sun', label: 'ライト' },
  { value: 'auto', icon: 'fa-circle-half-stroke', label: '自動' },
  { value: 'dark', icon: 'fa-moon', label: 'ダーク' },
];
---

<div class={`theme-switcher ${className}`} role="radiogroup" aria-label="テーマ">
  {themes.map(({ value, icon, label }) => (
    <Fragment>
      <input type="radio" name="theme" id={`theme-${value}`} value={value}>
      <label for={`theme-${value}`}>
        <i class={`fas ${icon}`} aria-hidden="true"></i>
        <span class="label-text">{label}</span>
      </label>
    </Fragment>
  ))}
</div>

<style>
  .theme-switcher {
    display: inline-flex;
    gap: 2px;
  }

  /* 見た目からは外すが、フォーカスと支援技術には残す。
     display: none だとフォーカスを受けられず、キーボードで操作できなくなる */
  .theme-switcher input[type="radio"],
  .theme-switcher .label-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .theme-switcher label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    cursor: pointer;
    color: var(--text-color-level-0);
    opacity: 0.5;
    transition: color 0.2s ease, opacity 0.2s ease, background-color 0.2s ease;
  }

  .theme-switcher i {
    font-size: 18px;
  }

  /* 選択中。data-theme が未設定の状態がそのまま「自動」にあたるので、
     JavaScript を待たずに初回ペイントから正しい位置に色がつく。
     html は GlobalLayout が出力する要素なので :global() でスコープ外に出す */
  :global(html:not([data-theme])) .theme-switcher label[for="theme-auto"],
  :global(html[data-theme="light"]) .theme-switcher label[for="theme-light"],
  :global(html[data-theme="dark"]) .theme-switcher label[for="theme-dark"] {
    color: var(--primary-color-level-0);
    opacity: 1;
  }

  /* 沈んでいる2つも押せることを見せる */
  .theme-switcher:hover label,
  .theme-switcher:focus-within label {
    opacity: 1;
  }

  .theme-switcher label:hover {
    background-color: var(--bg-color-level-2);
  }

  .theme-switcher input[type="radio"]:focus-visible + label {
    outline: 2px solid var(--primary-color-level-0);
    outline-offset: 2px;
  }
</style>

<script>
  const htmlElement = document.documentElement;

  function getCurrentTheme() {
    return htmlElement.getAttribute('data-theme') ?? 'auto';
  }

  function applyTheme(theme: string) {
    if (theme === 'auto') {
      htmlElement.removeAttribute('data-theme');
      localStorage.removeItem('theme');
    } else {
      htmlElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const currentTheme = getCurrentTheme();

    document.querySelectorAll('.theme-switcher').forEach(switcher => {
      const radios = switcher.querySelectorAll('input[name="theme"]') as NodeListOf<HTMLInputElement>;

      radios.forEach(radio => {
        radio.checked = radio.value === currentTheme;

        radio.addEventListener('change', () => {
          if (radio.checked) {
            applyTheme(radio.value);
          }
        });
      });
    });
  });
</script>
