---
import { yearOf } from "../utils/posts";

interface Props {
  /** 記事の日付。Blog では URL と同じく年の階層を表示する */
  date: string;
}

const { date } = Astro.props;

// トップへの導線はヘッダーのロゴが担うので、ここでは一覧への戻り道だけを出す
const pathname = Astro.url.pathname;
const pageType = pathname.startsWith("/blog/") ? "blog" : pathname.startsWith("/note/") ? "note" : "";
---

{pageType && (
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <a href={`/${pageType}/`}>{pageType}</a>
    {pageType === "blog" && (
      <Fragment>
        <span aria-hidden="true">/</span>
        <span>{yearOf(date)}</span>
      </Fragment>
    )}
  </nav>
)}

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-color-level-2);
  }

  .breadcrumb a,
  .breadcrumb a:visited {
    color: var(--text-color-level-2);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--primary-color-level-0);
  }
</style>
